{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['role', 'email']) && newData.child('role').isString() && newData.child('email').isString()"
      }
    },
    "sessions": {
      "$sessionId": {
        ".read": "auth !== null",
        ".write": "auth !== null",
        ".validate": "newData.hasChildren(['victimId', 'status', 'timestamp']) && newData.child('victimId').isString() && newData.child('status').isString() && newData.child('timestamp').isNumber()",
        "victimId": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    }
  }
}
