# Firebase configuration - copy this file to .env and fill in your values
# Get these from: Firebase Console → Project Settings → Your apps → Web app config

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# TURN server - REQUIRED for live stream when victim and police are on different devices/networks
# Without this, stream only works when both are on the same laptop/network
# Sign up free: https://dashboard.metered.ca/signup?tool=turnserver
# Then add your credentials URL (from dashboard):
# VITE_METERED_TURN_CREDENTIALS_URL=https://yourapp.metered.live/api/v1/turn/credentials?apiKey=YOUR_API_KEY
